<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Brand Header -->
    <ImageView
        android:id="@+id/imageMainLogo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_mountain_logo" />

    <TextView
        android:id="@+id/textMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="GeoRescuX"
        android:textColor="@color/brand_navy"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textMainSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Offline. Smarter. Safer."
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <!-- Progress / Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressRoleResolution"
        style="?android:attr/progressBarStyle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="36dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/brand_primary" />

    <TextView
        android:id="@+id/textRoleStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/role_verifying"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Failure / Recovery Actions (Visible only on failure or timeout) -->
    <LinearLayout
        android:id="@+id/layoutRoleRecovery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/textRoleError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/role_timeout_message"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonContinueStandard"
            style="@style/Widget.GeoRescuX.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/role_continue_button" />

        <Button
            android:id="@+id/buttonRetryRole"
            style="@style/Widget.GeoRescuX.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/role_retry_button" />

    </LinearLayout>

</LinearLayout>
