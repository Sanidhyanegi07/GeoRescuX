<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <!-- §21/§72: global active-SOS strip, present on every user screen. -->
    <include layout="@layout/view_active_sos_banner" />

    <TextView
        android:id="@+id/textMapRegion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/textMapConnectivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="2dp"
        android:text="@string/connection_checking"
        android:textColor="@color/mesh_sky"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Floating Quick Filter Bar -->
        <HorizontalScrollView
            android:id="@+id/scrollFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:scrollbars="none"
            android:clipToPadding="false">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupQuickFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <!-- Advanced Filter Modal Trigger -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOpenFilterDialog"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter"
                    android:textColor="@color/brand_primary"
                    android:textStyle="bold"
                    app:chipBackgroundColor="@color/white"
                    app:chipIcon="@drawable/ic_filter"
                    app:chipIconTint="@color/brand_primary"
                    app:chipStrokeColor="@color/brand_primary"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuickAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="All"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_chip_state_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuickFlood"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌊 Flood"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_chip_state_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuickEarthquake"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌋 Earthquake"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_chip_state_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuickFire"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Fire"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_chip_state_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuickLandslide"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪨 Landslide"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_chip_state_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuickRoadBlock"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚧 Road Block"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_chip_state_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuickCritical"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 Critical"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_chip_state_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuickHigh"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 High"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_chip_state_selector" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Active Filter Indicator Pill (Visible when filtered) -->
        <LinearLayout
            android:id="@+id/layoutActiveFilterStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="56dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#EE0F172A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textActiveFilterDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filtered: 3 incidents"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/buttonClearActiveFilter"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear Filter"
                android:src="@drawable/ic_close_circle"
                app:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/buttonMyLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:contentDescription="@string/map_my_location"
                android:src="@drawable/ic_nav_map"
                app:backgroundTint="@color/bg_card"
                app:tint="@color/mesh_sky" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/buttonZoomIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:contentDescription="Zoom in"
                android:src="@drawable/ic_zoom_in"
                app:backgroundTint="@color/bg_card"
                app:tint="@color/text_primary" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/buttonZoomOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Zoom out"
                android:src="@drawable/ic_zoom_out"
                app:backgroundTint="@color/bg_card"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/textMapCacheState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/bg_card_secondary"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Loading Map..."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- User Incident Reporting Floating Button -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/buttonReportIncident"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:text="Report Incident"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/hazard_orange"
            app:icon="@drawable/ic_report_incident"
            app:iconTint="@color/white"
            app:elevation="4dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/textNoOfflineMap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="10dp"
        android:text="@string/map_offline_map_unavailable"
        android:textColor="@color/hazard_orange"
        android:textSize="12sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonOpenSafeRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_button_violet"
        android:text="@string/map_open_safe_route"
        android:textColor="@color/white"
        app:backgroundTint="@null" />

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
