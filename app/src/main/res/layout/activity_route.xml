<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/buttonRouteBack"
            style="@style/Widget.GeoRescuX.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Safe Route"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Normal Mode / Pro Mode Badge -->
        <TextView
            android:id="@+id/textSafeRouteProBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_active"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="SOS Mode Active"
            android:textColor="@color/sos_red"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textNormalModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tab_container"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Normal Mode"
            android:textColor="@color/brand_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Route Inputs Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Origin input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Start Pin"
                            android:src="@drawable/ic_safe_route"
                            app:tint="@color/brand_primary" />

                        <AutoCompleteTextView
                            android:id="@+id/editTextStartNode"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_input_field"
                            android:completionThreshold="1"
                            android:hint="Your Location"
                            android:inputType="text"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Destination input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Destination Pin"
                            android:src="@drawable/ic_offline_maps"
                            app:tint="@color/sos_red" />

                        <AutoCompleteTextView
                            android:id="@+id/editTextDestinationNode"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_input_field"
                            android:completionThreshold="1"
                            android:hint="To: Safe Haven, Lower Market, Joshimath"
                            android:inputType="text"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/buttonFindRoute"
                            style="@style/Widget.GeoRescuX.Button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Find Route"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/buttonReroute"
                            style="@style/Widget.GeoRescuX.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Avoid Hazards"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Map View Container Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Floating Map Controls -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|top"
                        android:layout_margin="12dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/buttonMyLocation"
                            style="@style/Widget.GeoRescuX.Button.MapControl"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="📍"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/buttonZoomIn"
                            style="@style/Widget.GeoRescuX.Button.MapControl"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="6dp"
                            android:text="+"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/buttonZoomOut"
                            style="@style/Widget.GeoRescuX.Button.MapControl"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="4dp"
                            android:text="−"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- Bottom Floating Legend Overlay -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_card_white"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Hazards"
                            android:textColor="@color/hazard_orange"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="● Blocked"
                            android:textColor="@color/sos_red"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="● Safe Path"
                            android:textColor="@color/safe_green"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textViewMapCacheState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|top"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_pill_low_risk"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="Offline Regional Map"
                        android:textColor="@color/safe_green"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Region & Connectivity Subtitles -->
            <TextView
                android:id="@+id/textRegionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Region: Uttarakhand Evacuation Map"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/textConnectivityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="● Offline routing active"
                android:textColor="@color/safe_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Route Result Card (Safe Route & Safe Route Pro) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Route Found"
                            android:src="@drawable/ic_safe_route"
                            app:tint="@color/brand_primary" />

                        <TextView
                            android:id="@+id/textViewRouteSummary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Safe Route: 24 km • 1 hr 12 min"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textViewNoRoute"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Select a start and a destination, then find a route."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textViewHazardWarnings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pill_pending"
                        android:padding="8dp"
                        android:text="Hazard warnings: 1 active hazard on secondary segment"
                        android:textColor="@color/hazard_amber"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/buttonStartNavigation"
                        style="@style/Widget.GeoRescuX.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="Start Navigation"
                        android:textSize="14sp" />

                    <!-- Safe Route Pro Back to SOS Action -->
                    <Button
                        android:id="@+id/buttonBackToSos"
                        style="@style/Widget.GeoRescuX.Button.Danger.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Back to SOS"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Route Steps Container -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Evacuation Segments"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/routeStepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Hidden elements for code compatibility -->
            <TextView
                android:id="@+id/textViewNoMapData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/safeRouteProPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView android:id="@+id/textProSosState" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/textProBleState" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
