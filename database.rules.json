{
  "rules": {
    ".read": false,
    ".write": false,

    "sos_alerts": {
      ".read": "auth != null && auth.token.admin == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.admin == true)",
        "isVerified": {
          ".read": "auth != null && (auth.uid == $uid || auth.token.admin == true)",
          ".write": "auth != null && auth.token.admin == true && newData.exists()",
          ".validate": "newData.isBoolean()"
        },
        "$alertId": {
          ".write": "auth != null && auth.uid == $uid && $alertId !== 'isVerified' && newData.exists()",
          ".validate": "$alertId !== 'isVerified' && newData.hasChildren(['id', 'status', 'startedAtMs'])",
          "status": {
            ".write": "auth != null && ((auth.uid == $uid && $alertId !== 'isVerified') || (auth.token.admin == true && newData.exists() && newData.val() == 'RESOLVED'))",
            ".validate": "newData.isString() && ((auth.uid == $uid && (newData.val() == 'ACTIVE' || newData.val() == 'COMPLETED')) || (auth.token.admin == true && newData.val() == 'RESOLVED'))"
          }
        }
      }
    },

    "users": {
      ".read": "auth != null && auth.token.admin == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.admin == true)",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "contacts": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "hazards": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin == true"
    },

    "blocked_roads": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin == true"
    },

    "emergency_resources": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin == true"
    },

    "incidents": {
      ".read": "auth != null",
      "$incidentId": {
        ".write": "auth != null"
      }
    },

    "events": {
      ".read": "auth != null && auth.token.admin == true",
      ".write": "auth != null && auth.token.admin == true"
    },

    "admin_alerts": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin == true"
    },

    "verification_requests": {
      ".read": "auth != null && auth.token.admin == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.admin == true)",
        ".write": "auth != null && ((auth.uid == $uid && newData.exists() && newData.hasChildren(['uid', 'status', 'name', 'timestampMs']) && (!data.exists() || data.child('status').val() == 'PENDING') && newData.child('status').val() == 'PENDING') || (auth.token.admin == true && newData.exists()))",
        ".validate": "newData.hasChildren(['status'])",
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'PENDING' || newData.val() == 'VERIFIED' || newData.val() == 'REJECTED')"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val() == $uid"
        }
      }
    },

    "admin_data": {
      ".read": "auth != null && auth.token.admin == true",
      ".write": "auth != null && auth.token.admin == true"
    }
  }
}
